set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
set(CMAKE_C_COMPILER clang-cl)
set(CMAKE_CXX_COMPILER clang-cl)
set(CMAKE_C_COMPILER_TARGET x86_64-pc-windows-msvc)
set(CMAKE_CXX_COMPILER_TARGET x86_64-pc-windows-msvc)
set(CMAKE_LINKER lld-link)
set(CMAKE_AR llvm-lib)
get_filename_component(CHORD_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(CMAKE_RC_COMPILER "${CHORD_ROOT}/cmake/llvm-rc.sh")
set(CMAKE_MT llvm-mt)
set(CMAKE_MSVC_RUNTIME_LIBRARY MultiThreaded)
set(WINSDK "${CHORD_ROOT}/third_party/windows-sdk")
set(SDK_INCLUDE "${WINSDK}/sdk/include")
set(CMAKE_C_FLAGS_INIT "-fuse-ld=lld /imsvc${WINSDK}/crt/include /imsvc${SDK_INCLUDE}/ucrt /imsvc${SDK_INCLUDE}/um /imsvc${SDK_INCLUDE}/shared /imsvc${SDK_INCLUDE}/winrt /D_CRT_SECURE_NO_WARNINGS")
set(CMAKE_CXX_FLAGS_INIT "${CMAKE_C_FLAGS_INIT} /EHsc")
set(CMAKE_RC_FLAGS_INIT "-I${WINSDK}/crt/include -I${SDK_INCLUDE}/ucrt -I${SDK_INCLUDE}/um -I${SDK_INCLUDE}/shared")
set(CMAKE_EXE_LINKER_FLAGS_INIT "/libpath:${WINSDK}/crt/lib/x86_64 /libpath:${WINSDK}/sdk/lib/um/x86_64 /libpath:${WINSDK}/sdk/lib/ucrt/x86_64")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${CMAKE_EXE_LINKER_FLAGS_INIT}")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "${CMAKE_EXE_LINKER_FLAGS_INIT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
